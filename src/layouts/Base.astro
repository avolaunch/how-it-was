---
import '../styles/global.css';
const { title = 'How It Was', description = 'Document the condition before it changes hands.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8fafc" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-label="How It Was home"><span class="wordmark-symbol">H<span>/</span>W</span><span>How It Was</span></a>
      <nav aria-label="Main navigation"><a href="/#how-it-works">How it works</a><a href="/#uses">Where it helps</a><a class="nav-cta" href="/vehicle-transport/">Try the walkthrough <span aria-hidden="true">↗</span></a></nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer"><div class="wrap footer-inner"><a class="wordmark" href="/">How It Was</a><p>A clear record of condition at the moments that matter.</p><span>© {new Date().getFullYear()} How It Was</span></div></footer>
  </body>
</html>
